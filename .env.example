# กุญแจของ LINE — เอามาจาก LINE Developers Console
# ห้าม commit ค่าจริง ไฟล์ .env.local ถูก gitignore ไว้แล้ว
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# รหัสช่องจาก Developers Console (ตัวเลข) — ตรงกับ channel.line_channel_id
# หนึ่งบัญชีรันแคมเปญทีละหนึ่ง (BR-68)
LINE_CHANNEL_ID=
# userId ของบอทเอง — คนละค่ากับข้างบน · นี่คือสิ่งที่ LINE ส่งมาใน destination
LINE_BOT_USER_ID=

# ทางเข้าสำหรับทดสอบ — ข้าม Google แต่ไม่ข้ามรายชื่อที่อนุญาต
# ต้องเป็น "1" เป๊ะ · ปิดตายบน production ไม่ว่าตั้งค่านี้ไว้หรือไม่
ALLOW_DEV_LOGIN=

# กุญแจเข้ารหัสโทเคนของ LINE ก่อนเก็บ (DD-03) — 32 ไบต์ base64
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY_V1=

# Postgres · รันในเครื่องก่อน ย้ายขึ้น Supabase ทีหลังได้ด้วย URL เดียว
DATABASE_URL=postgres://localhost:5432/linekit_dev
TEST_DATABASE_URL=postgres://localhost:5432/linekit_test
