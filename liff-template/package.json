{
  "name": "liff-quiz-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:reset": "psql -q postgres -c \"DROP DATABASE IF EXISTS liff_template_test\" -c \"CREATE DATABASE liff_template_test\" && psql -q -v ON_ERROR_STOP=1 -d liff_template_test -f db/schema.sql"
  },
  "dependencies": {
    "@line/liff": "^2.24.0",
    "next": "^15.5.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
