# LIFF ID of the LINE Login channel this deployment uses — from the LINE Developers
# Console, LIFF tab, after you add a LIFF app to your Messaging API channel.
# Read at runtime by the client bundle (NEXT_PUBLIC_ prefix required by Next.js) — never
# hardcode a LIFF ID as a source constant, since the same code must work for any deployment.
NEXT_PUBLIC_LIFF_ID=

# Messaging API channel credentials — from the LINE Developers Console, Messaging API tab.
# Used server-side only (API routes), for pushing notification cards (partner-answered,
# group-complete, reminders, etc). Never exposed to the browser.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Standard Postgres connection string (postgres://user:password@host:port/database) for
# duo/group mode's cross-device state (waiting for a partner/group to fill up). Works with
# any Postgres — Supabase's own, Vercel Postgres, Neon, self-hosted, etc — see "Setting up
# Postgres for duo/group mode" in the README. Leave unset to use the local file-store
# default (lib/store/fileStore.ts) for quick local testing without a real database — fine
# for solo mode, and for duo/group testing on one machine, but not safe for a real
# multi-instance/serverless deployment.
DATABASE_URL=
